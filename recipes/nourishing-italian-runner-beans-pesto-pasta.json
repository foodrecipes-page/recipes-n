      "name": "runner beans",
      "amount": "1 pound",
      "notes": "trimmed and cut into 1 inch pieces"
    },
    {
      "name": "fresh basil",
      "amount": "1 cup",
      "notes": "packed"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "peeled and minced"
    },
    {
      "name": "pine nuts",
      "amount": "1/4 cup",
      "notes": "toasted"
    },
    {
      "name": "parmesan cheese",
      "amount": "1/2 cup",
      "notes": "vegetarian"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup",
      "notes": "extra virgin"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "pasta",
      "amount": "8 ounces",
      "notes": "linguine or fettuccine"
    }
  ],
  "instructions": [
    "Cook the pasta in a large pot of boiling salted water until al dente.",
    "Drain the pasta and set it aside to rest.",
    "Blend the basil, garlic, pine nuts, and parmesan cheese in a food processor until well combined.",
    "Add the lemon juice and olive oil to the food processor and blend until smooth.",
    "Add the cooked pasta to the pesto sauce and toss to combine.",
    "Add the runner beans to the pasta and toss to combine.",
    "Season the pasta with salt and black pepper to taste.",
    "Serve the pasta hot, garnished with additional basil if desired."
