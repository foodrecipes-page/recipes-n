      "amount": "1tsp"
    },
    {
      "name": "parsley",
      "amount": "10g",
      "notes": "chopped"
    },
    {
      "name": "crème fraîche",
      "amount": "50g",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Preheat oven to 200°C.",
    "Peel and thinly slice potatoes and celery root into 2mm rounds.",
    "In a small bowl, whisk butter, milk, treacle, salt, pepper, and paprika until smooth.",
    "Grease 4 mini cocottes with a little butter.",
    "Layer the sliced potatoes and celery root in each cocotte, sprinkling shredded cheese between layers.",
    "Pour the treacle-milk mixture evenly over the vegetables and cheese.",
    "Spoon a small amount of crème fraîche on top of each mini gratin.",
    "Cover the cocottes with foil and bake for 25 minutes.",
    "Remove foil and bake an additional 5 minutes until the cheese is golden and bubbling.",
    "Garnish with chopped parsley before serving."
  ],
