{
  "title": "Nostalgic German Cheese Gratin",
  "description": "A comforting, earthy German cheese gratin that melts into a creamy, sweet treacle glaze, perfect for a relaxed Sunday meal.",
  "cuisine": "German",
  "diet": null,
  "meal": "dinner",
