{
  "title": "Nutty Dark Syrian Chicken Tagine",
  "description": "A rich and silky Syrian dish featuring dark chocolate chips and lacquer glaze, perfect for a low-calorie solo dinner",
  "cuisine": "Syrian",
  "diet": [
    "low-calorie",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "dark chocolate chips",
      "amount": "1/2 cup"
    },
    {
      "name": "lacquer glaze",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "chopped walnuts",
      "amount": "1/4 cup"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium heat",
    "Add the chicken to the skillet and cook until browned on all sides",
    "Add the cumin, smoked paprika, salt, and pepper to the skillet and stir to combine",
    "Add the chicken broth to the skillet and bring to a boil",
    "Reduce the heat to low and simmer for 20 minutes",
    "Stir in the dark chocolate chips and lacquer glaze",
    "Continue to simmer for an additional 5 minutes",
    "Stir in the chopped walnuts",
    "Serve the chicken hot, garnished with additional walnuts if desired"
  ],
