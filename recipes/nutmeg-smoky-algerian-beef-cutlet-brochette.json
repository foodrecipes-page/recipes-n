      "name": "beef cutlet",
      "amount": "1 pound",
      "notes": "thinly sliced"
    },
    {
      "name": "smoked paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "garlic powder",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "ground nutmeg",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium high heat.",
    "In a large bowl, whisk together smoked paprika, black pepper, salt, garlic powder, and ground nutmeg.",
    "Add the sliced beef cutlet to the bowl and toss to coat evenly with the spice mixture.",
    "Thread the coated beef cutlet onto skewers, if using.",
    "Brush the grill with olive oil to prevent sticking.",
    "Grill the beef cutlet for 4-5 minutes per side, or until it reaches an internal temperature of 145 degrees.",
    "Transfer the grilled beef cutlet to a plate and squeeze with lemon juice.",
    "Serve immediately and enjoy."
  ],
