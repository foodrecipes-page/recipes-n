{
  "title": "Nutty Syrian Fish Flatbread",
  "description": "A crunchy and cultured Syrian dish featuring fish sauce and double rise bread, perfect for kids and gluten free friendly, cooked in a kazan cauldron.",
  "cuisine": "Syrian",
  "diet": [
    "gluten-free",
    "pescatarian"
  ],
