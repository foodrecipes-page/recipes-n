  "ingredients": [
    {
      "name": "fish sauce",
      "amount": "1/4 cup",
      "notes": "nam pla"
    },
    {
      "name": "double rise bread",
      "amount": "1 loaf",
      "notes": "gluten free friendly"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "walnuts",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the kazan cauldron over medium heat.",
    "Mix the fish sauce, olive oil, chopped onion, minced garlic, salt, and black pepper in a bowl.",
    "Add the chopped walnuts to the bowl and stir well.",
    "Slice the double rise bread into 1 inch thick rounds.",
    "Brush the mixture from the bowl onto each bread round.",
    "Place the bread rounds in the preheated kazan cauldron.",
    "Cook for 5 minutes on each side or until crispy and golden brown.",
    "Serve hot and enjoy."
  ],
