{
  "title": "Nourishing Silky Australian Shrimp Skewers",
  "description": "A jammy and silky Australian dish featuring garlic granules, served in a stone-bowl-dolsot on a tagliere, this recipe is low-sodium-friendly and perfect for a special occasion.",
  "cuisine": "Australian",
  "diet": [
    "low-sodium"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "Australian shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "garlic granules",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "honey",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt-free seasoning blend",
      "amount": "1 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "stone-bowl-dolsot",
      "amount": "1",
      "notes": "for serving"
    },
    {
      "name": "tagliere",
      "amount": "1",
      "notes": "for serving"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "Thread the shrimp onto skewers, leaving a small space between each shrimp.",
    "In a small bowl, mix together the garlic granules, olive oil, lemon juice, honey, and salt-free seasoning blend.",
    "Brush the garlic mixture onto both sides of the shrimp.",
    "Grill the shrimp for 2-3 minutes per side, or until they are pink and cooked through.",
    "Transfer the shrimp to a stone-bowl-dolsot and serve on a tagliere.",
    "Garnish with chopped fresh parsley.",
    "Serve immediately and enjoy."
  ],
