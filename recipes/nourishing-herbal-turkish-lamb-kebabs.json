{
  "title": "Nourishing Herbal Turkish Lamb Kebabs",
  "description": "A low-calorie and flavorful Turkish dish featuring lamb, applesauce, and herbs, perfect for a hangover cure or a healthy meal option.",
  "cuisine": "Turkish",
  "diet": [
    "low-calorie",
    "gluten-free"
  ],
