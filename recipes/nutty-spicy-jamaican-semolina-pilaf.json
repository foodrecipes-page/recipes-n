      "amount": "1 tsp",
      "notes": "ground"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "peanuts",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "coconut oil",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large saucepan over medium heat.",
    "Add the diced onion and cook until translucent, about 5 minutes.",
    "Add the diced scotch bonnet peppers and cook for an additional 2 minutes.",
    "Add the thyme, allspice, and salt, and stir to combine.",
    "Add the semolina and stir to combine, cooking for 1-2 minutes.",
    "Add the water and bring to a boil, then reduce the heat to low and cover.",
    "Simmer for 15-20 minutes, or until the semolina is cooked and fluffy.",
    "Stir in the chopped peanuts and serve hot from a lazy Susan spinner."
  ],
