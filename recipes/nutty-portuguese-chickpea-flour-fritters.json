{
  "title": "Nutty Portuguese Chickpea Flour Fritters",
  "description": "Crispy, nutty, and light Portuguese-inspired fritters made with chickpea flour, perfect as a snack or dessert substitute.",
  "cuisine": "Portuguese",
  "diet": null,
  "meal": "snack",
  "ingredients": [
    {
      "name": "chickpea flour",
      "amount": "1 cup",
      "notes": "fine or medium texture"
    },
    {
      "name": "almond meal",
      "amount": "1/2 cup",
      "notes": "adds nutty flavor and texture"
    },
    {
      "name": "sugar substitute",
      "amount": "1 tablespoon",
      "notes": "such as erythritol or xylitol"
    },
    {
      "name": "large egg",
      "amount": "1",
      "notes": "room temperature"
    },
    {
      "name": "milk",
      "amount": "1/2 cup",
      "notes": "low-fat or non-dairy milk alternative"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup",
      "notes": "for frying"
    },
    {
      "name": "vanilla extract",
      "amount": "1/4 teaspoon",
      "notes": "optional"
    },
    {
      "name": "salt",
      "amount": "1/8 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "sugar",
      "amount": "1 tablespoon",
      "notes": "optional"
    },
    {
      "name": "coconut flakes",
      "amount": "1/4 cup",
      "notes": "optional"
    },
    {
      "name": "chocolate chips",
      "amount": "1/4 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "In a large bowl, whisk together chickpea flour, almond meal, and sugar substitute.",
    "Make a well in the center and add the egg, milk, and vanilla extract (if using).",
    "Whisk the wet ingredients into the dry ingredients until smooth.",
    "Heat the olive oil in a large skillet over medium-high heat.",
    "Using a 1/4 cup measuring cup, scoop the batter into the hot oil.",
    "Flatten the batter slightly with a spatula and cook for 2-3 minutes on each side.",
    "Repeat with the remaining batter, adjusting the heat as needed to prevent burning.",
    "Using a slotted spoon, transfer the fritters to a paper towel-lined plate to drain excess oil.",
    "If desired, sprinkle with coconut flakes or chocolate chips while still warm.",
    "Serve the fritters warm or at room temperature."
  ],
