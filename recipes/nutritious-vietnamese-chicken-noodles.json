    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "canola oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "rice noodles",
      "amount": "8 ounces"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "bean sprouts",
      "amount": "1 cup"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the canola oil in a large saucepan over medium heat",
    "Add the sliced onion and cook until softened, about 3 minutes",
    "Add the minced garlic and grated ginger and cook for 1 minute",
    "Add the chicken to the saucepan and cook until browned, about 5 minutes",
    "Add the chicken broth, soy sauce, and rice noodles to the saucepan and bring to a simmer",
    "Reduce the heat to low and cook, covered, for 10 minutes",
    "Stir in the bean sprouts and cook for an additional 2 minutes",
    "Season with salt and pepper to taste",
    "Serve hot, garnished with chopped green onions"
  ],
