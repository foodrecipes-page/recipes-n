{
  "title": "Nourishing Silky Brazilian Barramundi Skewers",
  "description": "A grassy and silky Brazilian dish featuring barramundi, dashi extract, and nut free friendly ingredients, served on a hot stone plate.",
  "cuisine": "Brazilian",
  "diet": [
    "gluten-free",
    "low-carb",
    "nut-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "barramundi fillets",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "dashi extract",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the hot stone plate to 400 degrees Fahrenheit.",
    "Thread the barramundi pieces onto skewers, leaving a small space between each piece.",
    "In a small bowl, whisk together dashi extract, coconut oil, lime juice, garlic, and ginger.",
    "Brush the mixture onto both sides of the barramundi pieces.",
    "Season with salt and black pepper.",
    "Place the skewers on the preheated hot stone plate and cook for 8-10 minutes, flipping halfway through.",
    "Sprinkle with chopped scallions and serve immediately.",
    "Serve with additional lime wedges on the side, if desired."
  ],
