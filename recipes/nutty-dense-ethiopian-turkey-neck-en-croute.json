      "amount": "1 tsp",
      "notes": "custom blend"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "preheat oven to 400\u00155f.",
    "in a large bowl, whisk together teff flour, berbere spice, nut-free spice blend, salt, and black pepper.",
    "add the chopped onion, grated ginger, and minced garlic to the bowl and mix well.",
    "add the turkey necks to the bowl and toss to coat with the spice mixture.",
    "brush the turkey necks with olive oil and place them in a large baking dish.",
    "cover the baking dish with foil and bake for 30 minutes.",
    "remove the foil and continue baking for an additional 20-25 minutes, or until the turkey necks are cooked through and the internal temperature reaches 165\u00155f.",
    "serve the turkey necks hot with injera on the side."
  ],
