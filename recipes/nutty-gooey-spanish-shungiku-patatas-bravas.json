      "name": "shungiku",
      "amount": "1 bunch",
      "notes": "also known as chrysanthemum greens"
    },
    {
      "name": "potatoes",
      "amount": "4 large",
      "notes": "peeled and diced"
    },
    {
      "name": "almonds",
      "amount": "1/2 cup",
      "notes": "sliced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomato sauce",
      "amount": "1 cup"
    },
    {
      "name": "vegan mozzarella",
      "amount": "1 cup",
      "notes": "shredded"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large clay pot, heat the olive oil over medium heat.",
    "Add the sliced almonds and cook until fragrant and lightly toasted.",
    "Add the diced potatoes, smoked paprika, and minced garlic, and cook for 5 minutes.",
    "Add the shungiku and cook until wilted.",
    "Stir in the tomato sauce and bring to a simmer.",
    "Transfer the clay pot to the preheated oven and bake for 20 minutes.",
    "Remove the pot from the oven and top with shredded vegan mozzarella.",
    "Return the pot to the oven and bake for an additional 5 minutes, or until the cheese is melted and bubbly."
  ],
