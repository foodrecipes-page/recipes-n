  "ingredients": [
    {
      "name": "feather blade beef",
      "amount": "1 pound",
      "notes": "cut into thin slices"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "soy sauce",
      "amount": "1/4 cup"
    },
    {
      "name": "brown sugar",
      "amount": "2 tablespoons"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "sesame oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Bring the beef broth to a boil in a large pot.",
    "Add the sliced beef to the pot and cook for 5 minutes.",
    "Add the soy sauce, brown sugar, black pepper, garlic, and ginger to the pot and stir to combine.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Heat the sesame oil in a small pan over medium heat.",
    "Add the chopped green onions to the pan and cook for 1 minute.",
    "To assemble the bowls, place a portion of the beef and broth into a hot dolsot stone bowl.",
    "Garnish with the cooked green onions and serve immediately."
  ],
