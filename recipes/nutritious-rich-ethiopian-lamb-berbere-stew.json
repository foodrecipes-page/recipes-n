      "amount": "1-inch piece",
      "notes": "grated"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in the claypot over medium heat.",
    "Add the onion and cook until softened, about 5 minutes.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Add the lamb and cook until browned on all sides, about 5 minutes.",
    "Add the berbere spice, muscovado sugar, salt, and pepper, and stir to combine.",
    "Add the beef broth and bring to a boil.",
    "Cover the claypot and transfer to the oven, cooking at 300 degrees for 2.5 hours.",
    "Remove the claypot from the oven and let cool slightly.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
  ],
