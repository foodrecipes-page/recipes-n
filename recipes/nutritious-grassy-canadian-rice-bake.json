{
  "title": "Nutritious Grassy Canadian Rice Bake",
  "description": "A delicious and comforting Canadian dish featuring grassy notes from fresh herbs, creamy texture, and extra virgin olive oil. Perfect for a lazy Sunday.",
  "cuisine": "Canadian",
  "diet": [
    null
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "Rice",
      "amount": "2 cups",
      "notes": "preferably Canadian long-grain rice"
    },
    {
      "name": "Extra Virgin Olive Oil",
      "amount": "2 tbsp",
      "notes": ""
    },
    {
      "name": "Brined Chicken Breast",
      "amount": "1",
      "notes": "dried and cut into 1-inch cubes"
    },
    {
      "name": "Fresh Parsley",
      "amount": "1 bunch",
      "notes": "chopped"
    },
    {
      "name": "Fresh Dill",
      "amount": "1/2 bunch",
      "notes": "chopped"
    },
    {
      "name": "Salt",
      "amount": "1 tsp",
      "notes": "use a salt-block "
    },
    {
      "name": "Black Pepper",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "Low-Sodium Chicken Broth",
      "amount": "1 cup",
      "notes": ""
    }
  ],
  "instructions": [
    "Preheat the oven to 375°F (190°C).",
    "Season the dried chicken breast with salt, black pepper, and chopped parsley and dill.",
    "Heat the extra virgin olive oil in a salt-block over medium heat.",
    "Add the chicken to the salt-block and cook until browned on all sides, about 5 minutes.",
    "Transfer the chicken to a 9x13-inch baking dish.",
    "Add the cooked rice, chicken broth, and chopped parsley and dill to the baking dish.",
    "Mix well and cover with aluminum foil.",
    "Bake for 25 minutes, then remove the foil and continue baking for an additional 10 minutes.",
    "Let the dish rest for 5 minutes before serving."
  ],
