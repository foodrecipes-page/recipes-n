{
  "title": "Nourishing Polish Mushroom Stew",
  "description": "A tangy and juicy Polish dish featuring thyme, perfect for a lazy Sunday, served in a stone bowl and suitable for Jain-friendly diets.",
  "cuisine": "Polish",
  "diet": [
    "jain",
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "mushrooms",
      "amount": "2 cups",
      "notes": "mix of cremini and shiitake"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "thyme",
      "amount": "2 sprigs",
      "notes": "fresh"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups",
      "notes": "low sodium"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons",
      "notes": "canned"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "extra virgin"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large stone bowl over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the mushrooms and cook until they release their liquid and start to brown, about 5 minutes.",
    "Add the thyme sprigs and cook for 1 minute, until fragrant.",
    "Add the vegetable broth, tomato paste, salt, and black pepper, and stir to combine.",
    "Bring the stew to a boil, then reduce the heat to low and simmer, covered, for 20 minutes.",
    "Serve the stew hot, garnished with additional thyme if desired.",
    "Let the stew cool slightly before serving, to allow the flavors to meld together."
  ],
