      "name": "chickpeas",
      "amount": "2 cups"
    },
    {
      "name": "hummus",
      "amount": "1 cup",
      "notes": "make sure it's dairy-free"
    },
    {
      "name": "pistachios",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "sesame seeds",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "pepper",
      "amount": "to taste"
    },
    {
      "name": "tortilla chips",
      "amount": "1 cup",
      "notes": "crushed"
    },
    {
      "name": "tomato",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "cumin",
      "amount": "1 tsp"
    },
    {
      "name": "coriander",
      "amount": "1 tsp"
    },
    {
      "name": "garlic",
      "amount": "1 clove",
      "notes": "minced"
    }
  ],
  "instructions": [
    "Preheat oven to 400°F (200°C).",
    "In a blender or food processor, combine chickpeas, hummus, pistachios, sesame seeds, cumin, coriander, and garlic. Blend until smooth.",
    "Transfer the mixture to a baking dish and smooth the top.",
    "Drizzle with olive oil and sprinkle with salt and pepper.",
    "Top with crushed tortilla chips and diced tomato.",
    "Bake for 20 minutes, or until the top is crispy and golden brown.",
    "Serve hot, garnished with additional pistachios and sesame seeds if desired."
  ],
