  "ingredients": [
    {
      "name": "long grain rice",
      "amount": "1 cup",
      "notes": "preferably uncooked"
    },
    {
      "name": "caraway seeds",
      "amount": "2 tsp",
      "notes": ""
    },
    {
      "name": "vegetable oil",
      "amount": "1 tbsp",
      "notes": ""
    },
    {
      "name": "onion",
      "amount": "1 small",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "grated cheese (tasty or mozzarella)",
      "amount": "1 cup",
      "notes": "divided"
    },
    {
      "name": "beef broth",
      "amount": "2 cups",
      "notes": ""
    },
    {
      "name": "salt",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "pepper",
      "amount": "1/2 tsp",
      "notes": ""
    },
    {
      "name": "walnuts or pecans",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat a clay pot over medium heat.",
    "Add the vegetable oil, then sauté the chopped onion and minced garlic until softened.",
    "Add the caraway seeds and cook for 1 minute.",
    "Add the rice, beef broth, salt, and pepper, stirring well to combine.",
    "Bring the mixture to a boil, then cover the clay pot and reduce heat to low.",
    "Cook for 15-20 minutes, or until the water has been absorbed and the rice is tender.",
    "Remove the clay pot from heat and stir in 1/2 cup of the grated cheese.",
    "Transfer the pilaf to a serving dish, then sprinkle with the chopped nuts.",
    "Serve hot, topped with the remaining grated cheese.",
    "Serve immediately."
  ],
