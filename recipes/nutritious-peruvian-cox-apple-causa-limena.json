      "name": "Cox apples",
      "amount": "2",
      "notes": "peeled and diced"
    },
    {
      "name": "mother sauce base",
      "amount": "1 cup",
      "notes": "made with olive oil and spices"
    },
    {
      "name": "lime juice",
      "amount": "1/4 cup"
    },
    {
      "name": "aji amarillo peppers",
      "amount": "2",
      "notes": "seeded and chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the mother sauce base in a wok over medium heat",
    "Add the diced Cox apples and cook for 5 minutes",
    "Add the lime juice, aji amarillo peppers, and garlic, and stir well",
    "Reduce heat to low and simmer for 10 minutes",
    "Stir in the chopped cilantro and season with salt and pepper to taste",
    "Serve the Causa Limena in the wok, garnished with additional cilantro if desired"
  ],
