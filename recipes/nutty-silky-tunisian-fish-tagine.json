  "ingredients": [
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "use a high-quality oil"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "fish",
      "amount": "1 pound",
      "notes": "sashimi-cut, any white fish works"
    },
    {
      "name": "dark chocolate chips",
      "amount": "1/4 cup",
      "notes": "at least 70% cocoa"
    },
    {
      "name": "preserved lemon",
      "amount": "1/4 cup",
      "notes": "diced"
    },
    {
      "name": "chopped almonds",
      "amount": "1/4 cup",
      "notes": "toasted"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon",
      "notes": "ground"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large clay or ceramic tagine over medium heat.",
    "Add the sliced onion and cook until it is translucent and starting to caramelize.",
    "Add the minced garlic and grated ginger and cook for 1 minute, stirring constantly.",
    "Add the sashimi-cut fish and cook for 2 minutes, stirring occasionally.",
    "Add the dark chocolate chips, preserved lemon, toasted almonds, ground cumin, and ground coriander, and stir to combine.",
    "Reduce the heat to low and simmer, covered, for 10 minutes.",
    "Season with salt and pepper to taste.",
    "Serve the tagine hot, garnished with additional toasted almonds and preserved lemon if desired."
  ],
