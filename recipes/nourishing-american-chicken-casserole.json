{
  "title": "Nourishing American Chicken Casserole",
  "description": "A sour and pillowy American dish featuring bay leaf and confit-tomato, perfect for a low-fat friendly meal.",
  "cuisine": "American",
  "diet": [
    "low-fat"
  ],
