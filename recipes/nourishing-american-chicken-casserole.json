      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "confit-tomato",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "bay leaf",
      "amount": "2",
      "notes": "dried"
    },
    {
      "name": "low-fat sour cream",
      "amount": "1/2 cup"
    },
    {
      "name": "shredded reduced-fat cheddar",
      "amount": "1 cup"
    },
    {
      "name": "whole wheat pasta",
      "amount": "8 ounces",
      "notes": "cooked al dente"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees Fahrenheit.",
    "In a large skillet, heat olive oil over medium heat and cook chicken until browned.",
    "Add confit-tomato, bay leaf, salt, and pepper to the skillet and stir to combine.",
    "In a large bowl, combine cooked pasta, chicken mixture, and chopped parsley.",
    "In a separate bowl, mix sour cream and shredded cheddar.",
    "Add the sour cream mixture to the pasta mixture and stir until well combined.",
    "Transfer the mixture to a 9x13 inch baking dish and bake for 25 minutes.",
    "Remove from oven and let cool for a few minutes before serving.",
    "Cook poultry to an internal temperature of 74°C / 165°F before serving."
  ],
