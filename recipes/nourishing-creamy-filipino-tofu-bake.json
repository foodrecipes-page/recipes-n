{
  "title": "Nourishing Creamy Filipino Tofu Bake",
  "description": "A citrusy and creamy Filipino dish featuring marinated tofu, perfect for a brunch mood, with an ayurvedic-tamasic friendly twist, wood-fired baked to perfection.",
  "cuisine": "Filipino",
  "diet": [
    "vegetarian"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "extra firm tofu",
      "amount": "1 block",
      "notes": "drained and cut into cubes"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "coconut cream",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chopped scallions",
      "amount": "1/4 cup",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Preheat the wood-fired oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together lemon juice, olive oil, garlic, and ginger to make the marinade.",
    "Add the cubed tofu to the marinade and let it sit for at least 30 minutes.",
    "In a separate bowl, mix together coconut cream, salt, and black pepper.",
    "Remove the tofu from the marinade and place it in a baking dish.",
    "Pour the coconut cream mixture over the tofu.",
    "Bake the tofu in the preheated wood-fired oven for 25 minutes.",
    "Garnish with chopped scallions and serve hot.",
    "Let it rest for a few minutes before serving."
  ],
