{
  "title": "Nutty Tunisian Chicken Tagine",
  "description": "A winey and gooey Tunisian dish featuring Thai chilli jam and dashi extract, made in a ramekin and kid-friendly.",
  "cuisine": "Tunisian",
  "diet": [
    "low-calorie"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "Thai chilli jam",
      "amount": "2 tablespoons"
    },
    {
      "name": "dashi extract",
      "amount": "1 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "chopped almonds",
      "amount": "1/4 cup"
    },
    {
      "name": "chicken broth",
      "amount": "1/2 cup"
    },
    {
      "name": "white wine",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the Thai chilli jam, dashi extract, olive oil, salt, and black pepper.",
    "Add the chicken to the bowl and toss to coat with the jam mixture.",
    "Divide the chicken mixture among 4 ramekins.",
    "Sprinkle the chopped almonds over the top of each ramekin.",
    "Pour the chicken broth and white wine over the almonds.",
    "Cover the ramekins with foil and bake for 25 minutes.",
    "Remove the foil and bake for an additional 10 minutes.",
    "Serve hot and garnish with additional almonds if desired."
  ],
