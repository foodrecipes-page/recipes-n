  "ingredients": [
    {
      "name": "spring onions",
      "amount": "1 bunch",
      "notes": "chopped"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "canned diced tomatoes",
      "amount": "1 can"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped spring onions and cook until they are softened and lightly browned.",
    "Add the minced garlic and cook for an additional minute.",
    "Pour in the vegetable broth, canned diced tomatoes, smoked paprika, salt, and black pepper, and stir to combine.",
    "Bring the stew to a simmer and let cook for 20 minutes.",
    "Stir in the chopped fresh parsley.",
    "Serve the stew hot in a bamboo tray.",
    "Garnish with additional parsley if desired."
  ],
