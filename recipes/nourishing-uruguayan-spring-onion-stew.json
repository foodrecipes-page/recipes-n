{
  "title": "Nourishing Uruguayan Spring Onion Stew",
  "description": "A floral and pillowy Uruguayan dish featuring spring onions, perfect for a weeknight dinner, simmered to perfection and served in a bamboo tray, this stew is dairy-free-friendly.",
  "cuisine": "Uruguayan",
  "diet": [
    "dairy-free",
