  "ingredients": [
    {
      "name": "semolina",
      "amount": "1 cup",
      "notes": "fine grind"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    },
    {
      "name": "almonds",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the semolina and cook, stirring constantly, for 2 minutes.",
    "Add the vegetable broth, paprika, cumin, salt, and black pepper, and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes, or until the semolina is tender.",
    "Stir in the chopped almonds.",
    "Serve the tagine hot, garnished with additional almonds if desired, in a scallop shell vessel."
  ],
