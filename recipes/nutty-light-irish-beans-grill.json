{
  "title": "Nutty Light Irish Beans Grill",
  "description": "A post-workout, low-calorie Irish dish featuring dried white navy beans and char-grilled chicken. Perfect for a quick and nutritious meal.",
  "cuisine": "irish",
  "diet": [
    "vegan",
    "gluten-free",
