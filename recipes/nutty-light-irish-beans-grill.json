  "ingredients": [
    {
      "name": "dried white navy beans",
      "amount": "1 cup",
      "notes": "soaked overnight"
    },
    {
      "name": "boneless, skinless chicken breast",
      "amount": "4 oz",
      "notes": "cut into small pieces"
    },
    {
      "name": "red bell pepper",
      "amount": "1",
      "notes": "seeded and chopped"
    },
    {
      "name": "onion",
      "amount": "1",
      "notes": "chopped"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups",
      "notes": "low-sodium"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp",
      "notes": "for grilling"
    },
    {
      "name": "salt",
      "amount": "to taste",
      "notes": "optional"
    },
    {
      "name": "black pepper",
      "amount": "to taste",
      "notes": "optional"
    },
    {
      "name": "garlic powder",
      "amount": "1 tsp",
      "notes": "optional"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Preheat grill to 400°F (200°C).",
    "In a medium bowl, whisk together chicken broth, olive oil, salt, black pepper, and garlic powder.",
    "Add the chopped onion and red bell pepper to the bowl and toss to coat.",
    "Grill the chicken and vegetables for 5-7 minutes per side, or until the chicken is cooked through.",
    "Add the soaked navy beans to the grill and cook for an additional 2-3 minutes, or until heated through.",
    "Transfer the beans and vegetables to a serving dish and squeeze with lemon juice.",
    "Serve hot and enjoy!"
  ],
