      "notes": "rinsed and drained"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "cider vinegar",
      "amount": "2 tablespoons"
    },
    {
      "name": "ferment-kimchi",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "curry powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "turmeric",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large pan over medium heat.",
    "Add the minced garlic and saute for 1 minute.",
    "Add the chopped onion and saute until it is translucent.",
    "Add the curry powder and turmeric, and stir for 1 minute.",
    "Add the red lentils, cider vinegar, and salt, and stir to combine.",
    "Add 2 cups of water and bring to a boil.",
    "Reduce the heat to low and simmer for 20 minutes.",
    "Stir in the chopped ferment-kimchi.",
    "Serve hot over rice or with naan bread."
  ],
