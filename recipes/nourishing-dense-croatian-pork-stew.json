{
  "title": "Nourishing Dense Croatian Pork Stew",
  "description": "A hearty and comforting Croatian stew featuring pork, dark brown soft sugar, and mustard, perfect for a midnight craving. This dish is also anti-inflammatory friendly.",
  "cuisine": "Croatian",
  "diet": [
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "pork shoulder",
      "amount": "2 pounds",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "dark brown soft sugar",
      "amount": "2 tablespoons"
    },
    {
      "name": "Dijon mustard",
      "amount": "1 tablespoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "4 cups"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    }
  ],
  "instructions": [
    "Heat oil in a large Dutch oven over medium heat.",
    "Add the pork cubes and cook until browned on all sides, about 5 minutes.",
    "Add the dark brown soft sugar, Dijon mustard, smoked paprika, garlic powder, salt, and black pepper, and cook for 1 minute.",
    "Add the chicken broth and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 2 hours.",
    "Add the sliced carrots and continue to simmer, covered, for another 30 minutes.",
    "Remove from heat and let cool slightly before serving.",
    "Serve hot, garnished with fresh parsley if desired."
  ],
