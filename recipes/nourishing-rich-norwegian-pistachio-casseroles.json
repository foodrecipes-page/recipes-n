    },
    {
      "name": "norwegian cheese",
      "amount": "2 cups",
      "notes": "such as jarlsberg or gudbrandsdalen"
    },
    {
      "name": "sour cream",
      "amount": "1 cup"
    },
    {
      "name": "eggs",
      "amount": "4 large"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup"
    },
    {
      "name": "chopped fresh dill",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 350 degrees Fahrenheit.",
    "In a large bowl, whisk together the pistachio meal, norwegian cheese, sour cream, eggs, salt, and black pepper.",
    "Melt the butter in a small saucepan over low heat.",
    "Add the melted butter to the bowl and stir until well combined.",
    "Stir in the chopped parsley and dill.",
    "Pour the mixture into a 9x13 inch baking dish.",
    "Bake for 35 minutes or until the edges are set and the center is slightly jiggly.",
    "Remove from the oven and let cool for 10 minutes before serving."
  ],
