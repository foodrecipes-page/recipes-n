{
  "title": "Nourishing Savory Peruvian Chicken Skewers",
  "description": "Savory Peruvian chicken skewers made with dried red chillies and a flexitarian friendly approach, perfect for a lazy Sunday meal.",
  "cuisine": "Peruvian",
  "diet": [
    "flexitarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "dried red chillies",
      "amount": "4",
      "notes": "crushed"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "onion",
      "amount": "1",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "bell pepper",
      "amount": "1",
      "notes": "cut into 1 inch pieces"
    }
  ],
  "instructions": [
    "Preheat grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, lime juice, garlic, salt, and black pepper.",
    "Add the chicken to the bowl and toss to coat with the marinade.",
    "Let the chicken marinate for at least 30 minutes.",
    "Thread the marinated chicken, onion, and bell pepper onto skewers.",
    "Grill the skewers for 10-12 minutes, turning occasionally.",
    "Brush the skewers with the crushed dried red chillies during the last 2 minutes of grilling.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve the skewers hot, garnished with fresh cilantro if desired."
  ],
