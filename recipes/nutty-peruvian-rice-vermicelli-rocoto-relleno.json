      "amount": "4 large",
      "notes": "roasted and peeled"
    },
    {
      "name": "Butter",
      "amount": "2 tbsp"
    },
    {
      "name": "Peanuts",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "Cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "Lime juice",
      "amount": "2 tbsp"
    },
    {
      "name": "Salt",
      "amount": "1 tsp"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "Preheat the binchotan grill to 400 degrees Fahrenheit.",
    "In a bowl, mix together cooked rice vermicelli, chopped peanuts, cilantro, lime juice, salt, and black pepper.",
    "Stuff each roasted rocoto pepper with the rice vermicelli mixture.",
    "Drizzle the tops with butter.",
    "Place the stuffed peppers in the binchotan grill and cook for 10 minutes.",
    "Remove the peppers from the grill and let them cool for a few minutes.",
    "Serve the Nutty Peruvian Rice Vermicelli Rocoto Relleno warm.",
    "Garnish with additional cilantro and lime wedges if desired."
  ],
