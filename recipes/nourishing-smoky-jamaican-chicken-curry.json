{
  "title": "Nourishing Smoky Jamaican Chicken Curry",
  "description": "A creamy and smoky Jamaican chicken curry featuring pandan leaf, perfect for a hangover cure, with a mustardy flavor and FODMAP friendly ingredients.",
  "cuisine": "Jamaican",
  "diet": [
    "gluten-free",
    "low-fodmap"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "pandan leaves",
      "amount": "2",
      "notes": "fresh or frozen"
    },
    {
      "name": "smoked paprika",
      "amount": "2 teaspoons"
    },
    {
      "name": "scotch bonnet peppers",
      "amount": "1",
      "notes": "seeded and chopped"
    },
    {
      "name": "coconut milk",
      "amount": "1 can",
      "notes": "full fat"
    },
    {
      "name": "mustard powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat olive oil in a large pan over medium heat.",
    "Add chopped scotch bonnet peppers and cook for 1 minute.",
    "Add chicken breast pieces and cook until browned on all sides.",
    "Add smoked paprika, mustard powder, salt, and black pepper, and stir to combine.",
    "Add pandan leaves and cook for 1 minute, until fragrant.",
    "Pour in coconut milk and bring to a simmer.",
    "Reduce heat to low and let curry simmer for 20 minutes, until chicken is cooked through.",
    "Remove pandan leaves and serve hot."
  ],
