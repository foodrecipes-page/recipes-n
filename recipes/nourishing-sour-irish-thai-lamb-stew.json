    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "thai holy basil krapao",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "irish stout",
      "amount": "1 cup",
      "notes": "guinness or similar"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons",
      "notes": "optional"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons",
      "notes": "for browning"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and cubed"
    }
  ],
  "instructions": [
    "Heat the oil in a large stone bowl dolsot over medium-high heat.",
    "Add the lamb pieces and brown on all sides, about 5 minutes.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the irish stout, fish sauce, and lime juice, stirring to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 1 hour.",
    "Add the chopped thai holy basil krapao and cook for an additional 10 minutes.",
    "Add the cubed potatoes and cook until tender, about 20 minutes.",
    "Season with salt and pepper to taste.",
    "Serve the stew hot, garnished with additional thai holy basil krapao if desired."
  ],
