{
  "title": "Nourishing Sour Irish Thai Lamb Stew",
  "description": "A hearty and sour one-pot Irish stew featuring Thai holy basil krapao, served in a stone bowl dolsot, suitable for shojin-friendly diets.",
  "cuisine": "Fusion",
  "diet": [
    "shojin"
  ],
