{
  "title": "Nutty Smoky Indian Chicken Curry",
  "description": "A savory and creamy Indian dish featuring sesame butter and smoked flavors, perfect for the monsoon season and diabetic-friendly.",
  "cuisine": "Indian",
  "diet": [
    "diabetic-friendly",
