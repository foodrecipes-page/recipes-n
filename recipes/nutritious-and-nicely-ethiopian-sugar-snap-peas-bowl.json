  "instructions": [
    "heat the ghee in a pan over medium heat.",
    "add the ginger, garlic, turmeric, cumin, coriander, and black pepper. cook for 1 minute, stirring constantly.",
    "add the bamboo shoots and cook for 2 minutes, stirring occasionally.",
    "add the sugar snap peas and cook for 4 minutes, stirring occasionally.",
    "stir in the coconut milk and bring to a simmer.",
    "reduce the heat to low and let cook for 5 minutes, stirring occasionally.",
    "season with salt to taste.",
    "garnish with chopped cilantro and serve hot.",
    "squeeze a little lemon juice over the top, if desired.",
    "serve immediately, garnished with fresh cilantro and a side of injera bread.",
    "transfer the contents of the pan to a bamboo tray, garnished with chopped cilantro and lemon wedges.",
    "serve the sugar snap peas bowl in a bamboo tray, garnished with chopped cilantro and lemon wedges."
