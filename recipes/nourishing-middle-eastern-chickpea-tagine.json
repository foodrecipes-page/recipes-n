      "amount": "1/2 tsp"
    },
    {
      "name": "ground turmeric",
      "amount": "1/2 tsp"
    },
    {
      "name": "tomato puree",
      "amount": "400g"
    },
    {
      "name": "lemon juice",
      "amount": "1 tbsp"
    },
    {
      "name": "fresh parsley",
      "amount": "2 tbsp",
      "notes": "chopped"
    },
    {
      "name": "toasted almond slivers",
      "amount": "2 tbsp",
      "notes": "for crunch"
    }
  ],
  "instructions": [
    "Heat 1 tbsp olive oil in a large skillet over medium heat.",
    "Add diced onion and cook until softened and golden brown, about 8 minutes.",
    "Stir in minced garlic, cumin, coriander, smoked paprika, cinnamon, and turmeric, and cook for 1 minute until fragrant.",
    "Pour in tomato puree, whisking to combine, and bring to a gentle simmer.",
    "Add drained chickpeas and the remaining 1 tbsp olive oil, stir, and season with salt and pepper.",
    "Reduce heat to low, cover, and simmer for 15 minutes, stirring occasionally.",
    "Finish with lemon juice, chopped parsley, and toasted almond slivers, then adjust seasoning.",
    "Serve hot over couscous or rice, spooning extra parsley on top for a fresh finish."
  ],
