{
  "title": "Nourishing Middle Eastern Chickpea Tagine",
  "description": "A floral, crispy chickpea tagine with caramelized onion, aromatic spices, and tomato puree, sugar-free and perfect for a quick weeknight dinner.",
  "cuisine": "Middle Eastern",
  "diet": [
    "vegetarian"
  ],
