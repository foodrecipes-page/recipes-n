{
  "title": "Nourishing Syrian Chicken Stew",
  "description": "A citrusy, juicy stew with a comforting blend of spices and a fragrant bouquet garni. Whole30-friendly and perfect for a hearty dinner.",
  "cuisine": "Syrian",
  "diet": [
    "whole30"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "Chicken thighs",
      "amount": "2 lbs",
      "notes": "boneless, skinless"
    },
    {
