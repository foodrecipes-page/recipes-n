      "amount": "1 tsp",
      "notes": "ground"
    },
    {
      "name": "Bouquet garni",
      "amount": "1 bundle",
      "notes": "parsley, thyme, bay leaf"
    }
  ],
  "instructions": [
    "Heat olive oil in a large pot over medium heat.",
    "Add diced onion and cook until translucent, about 3 minutes.",
    "Stir in minced garlic and cook for 30 seconds until fragrant.",
    "Add chicken thighs and brown on all sides, about 5 minutes.",
    "Toss in sliced carrots, red bell pepper, and diced tomatoes, stirring to combine.",
    "Sprinkle cumin, coriander, and add the bouquet garni to the pot.",
    "Pour in chicken broth, bring mixture to a gentle boil, then reduce heat and simmer, covered, for 25 minutes.",
    "Stir in fresh lemon juice and adjust seasoning with salt and pepper to taste.",
    "Remove bouquet garni and discard.",
    "Serve hot over cooked quinoa or with a side of fresh salad."
  ],
