  "ingredients": [
    {
      "name": "zucchini",
      "amount": "2 medium",
      "notes": "sliced into 1/4 inch thick rounds"
    },
    {
      "name": "binchotan-charcoal grilled red onion",
      "amount": "1 large",
      "notes": "thinly sliced"
    },
    {
      "name": "kalamata olives",
      "amount": "1 cup",
      "notes": "pitted"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "extra virgin olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "red wine vinegar",
      "amount": "2 tablespoons"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Preheat the binchotan-charcoal grill to medium-high heat.",
    "Grill the sliced red onion for 5 minutes per side, or until slightly charred.",
    "In a large bowl, combine the sliced zucchini, grilled red onion, kalamata olives, and crumbly feta cheese.",
    "In a small bowl, whisk together the extra virgin olive oil and red wine vinegar.",
    "Pour the dressing over the zucchini mixture and toss to combine.",
    "Sprinkle the chopped fresh parsley over the top of the salad and season with salt and pepper to taste.",
    "Serve the salad in a tagliere vessel and enjoy immediately."
  ],
