{
  "title": "Naturally Smoky Jamaican Duck Skewers",
  "description": "A fresh and springy Jamaican dish featuring duck fat, with an al-dente finish, perfect for a brunch mood, served on a wooden board.",
  "cuisine": "Jamaican",
  "diet": [
    "gluten-free"
  ],
