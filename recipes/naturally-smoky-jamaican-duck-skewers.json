  "ingredients": [
    {
      "name": "duck breast",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "duck fat",
      "amount": "1/4 cup"
    },
    {
      "name": "scotch bonnet peppers",
      "amount": "2",
      "notes": "seeded and chopped"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "thyme",
      "amount": "2 tablespoons",
      "notes": "chopped"
    },
    {
      "name": "allspice",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "wooden skewers",
      "amount": "10",
      "notes": "soaked in water for 30 minutes"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together duck fat, scotch bonnet peppers, green onions, thyme, allspice, salt, and black pepper.",
    "Add the duck breast pieces to the bowl and toss to coat with the marinade.",
    "Thread the marinated duck pieces onto the soaked wooden skewers.",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the duck is cooked to an internal temperature of 165 degrees Fahrenheit.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve the skewers on a wooden board, garnished with additional thyme and green onions if desired.",
    "Serve immediately and enjoy."
  ],
