    {
      "name": "lamb shoulder",
      "amount": "1 1/2 pounds",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "dates",
      "amount": "1 cup",
      "notes": "pitted"
    },
    {
      "name": "almonds",
      "amount": "1/2 cup",
      "notes": "sliced"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "2 inches",
      "notes": "grated"
    },
    {
      "name": "cumin",
      "amount": "2 teaspoons",
      "notes": "ground"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon",
      "notes": "smoked"
    },
    {
      "name": "salsa",
      "amount": "1 cup",
      "notes": "homemade or store bought"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "In a large bowl, mix together the lamb, cumin, paprika, garlic, and ginger.",
    "Heat the olive oil in the bottom of a ceramic tagine over medium high heat.",
    "Add the lamb mixture to the tagine and cook until browned on all sides.",
    "Add the onion to the tagine and cook until softened.",
    "Add the dates, almonds, and salsa to the tagine, stirring to combine.",
    "Cover the tagine and transfer it to the preheated oven.",
    "Bake for 2 1/2 hours, or until the lamb is tender and the top is crispy.",
    "Remove the tagine from the oven and let it cool for 10 minutes before serving."
  ],
