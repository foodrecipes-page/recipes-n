{
  "title": "Nutty Crispy Turkish Lamb Tagine",
  "description": "A rich and flavorful Turkish dish featuring crispy lamb, dates, and a spicy salsa, perfect for a special occasion or date night.",
  "cuisine": "Turkish",
  "diet": [
    "paleo"
  ],
