      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbled"
    }
  ],
  "instructions": [
    "Heat the olive oil in the iron teppan skillet over medium heat.",
    "Add the minced garlic and cook for 1 minute until fragrant.",
    "Add the diced confit tomato and cook for 3 minutes until heated through.",
    "Stir in the chopped pistachio and cook for 2 minutes until lightly toasted.",
    "Season with salt and black pepper to taste.",
    "Transfer the skillet to a serving plate and top with crumbled feta cheese.",
    "Garnish with chopped fresh parsley and serve immediately.",
    "Serve hot and enjoy!",
    "Store any leftovers in an airtight container in the refrigerator for up to 3 days."
  ],
