  "ingredients": [
    {
      "name": "malai",
      "amount": "1 cup",
      "notes": "or substitute with coconut cream"
    },
    {
      "name": "render-fat",
      "amount": "2 tablespoons"
    },
    {
      "name": "cauliflower rice",
      "amount": "2 cups"
    },
    {
      "name": "chicken breast",
      "amount": "1 pound"
    },
    {
      "name": "almonds",
      "amount": "1/2 cup",
      "notes": "sliced"
    },
    {
      "name": "onion",
      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "pandan leaves",
      "amount": "2 leaves"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the render-fat in a large skillet over medium heat.",
    "Add the sliced almonds and cook until lightly toasted.",
    "Add the diced onion and cook until translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the chicken breast and cook until browned.",
    "Add the malai, cauliflower rice, pandan leaves, salt, and pepper, and stir well.",
    "Transfer the mixture to a baking dish and bake at 375 degrees Fahrenheit for 20 minutes.",
    "Remove the pandan leaves and serve hot."
  ],
