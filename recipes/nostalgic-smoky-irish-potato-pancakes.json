{
  "title": "Nostalgic Smoky Irish Potato Pancakes",
  "description": "A flaky, smoky Irish pancake that pairs perfectly with a scoop of vanilla ice cream for a nostalgic brunch treat.",
  "cuisine": "Irish",
  "diet": [
    "kosher-friendly"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "potatoes",
      "amount": "600g grated",
      "notes": "medium"
    },
    {
      "name": "all-purpose flour",
      "amount": "120g (1 cup)",
      "notes": ""
    },
    {
      "name": "buttermilk",
      "amount": "120ml (1/2 cup)",
      "notes": "fermented"
    },
    {
      "name": "large eggs",
      "amount": "2",
      "notes": ""
    },
    {
      "name": "kosher salt",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "smoked paprika",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "smoked pepper",
      "amount": "1/4 tsp",
      "notes": ""
    },
    {
      "name": "fresh parsley, chopped",
      "amount": "2 tbsp",
      "notes": ""
    },
    {
      "name": "cheddar cheese, shredded",
      "amount": "30g (1/4 cup)",
      "notes": "optional"
    },
    {
      "name": "vanilla ice cream",
      "amount": "250ml (1 cup)",
      "notes": "serving"
    }
  ],
  "instructions": [
    "Peel and grate the potatoes, then squeeze out excess moisture with a clean towel.",
    "In a large bowl, combine grated potatoes, flour, smoked paprika, and kosher salt; mix until evenly coated.",
    "Whisk eggs, buttermilk, and smoked pepper in a separate bowl, then pour into the potato mixture and stir until smooth batter forms.",
    "Fold in chopped parsley and shredded cheddar, if using.",
    "Heat a non-stick skillet over medium heat and brush with a thin layer of melted butter or oil.",
    "Pour 1/4 cup batter per pancake onto the skillet, spreading slightly, and cook 3-4 minutes until golden edges form.",
    "Flip pancakes and cook another 2-3 minutes until crisp and cooked through.",
    "Serve hot with a scoop of vanilla ice cream on the side."
  ],
