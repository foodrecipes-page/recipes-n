  "ingredients": [
    {
      "name": "egg yolks",
      "amount": "4 large",
      "notes": "fresh"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "walnuts",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "onions",
      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "mushrooms",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Cook the sliced onions and mushrooms in butter over medium heat until they are softened.",
    "Add the chopped walnuts to the pan and cook for 1 minute.",
    "Push the onion and mushroom mixture to one side of the pan.",
    "Add a little more butter to the empty side of the pan if necessary, then pour in the egg yolks.",
    "Scramble the egg yolks until they are cooked through, breaking them up into small pieces as they cook.",
    "Mix the egg yolks with the onion and mushroom mixture.",
    "Season with salt and black pepper to taste.",
    "Stir in the chopped parsley.",
    "Serve the stir-fry hot."
  ],
