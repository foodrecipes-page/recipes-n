{
  "title": "Nutty Chinese Scallion Pancake Bake",
  "description": "A light and comforting Chinese dish featuring pecorino-romano cheese, scallion pancakes, and a wood-fired bake, all in individual mini cocottes.",
  "cuisine": "Chinese",
  "diet": [
    "low-fat"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "all-purpose flour",
      "amount": "2 cups",
      "notes": "for pancake dough"
    },
    {
      "name": "scallions",
      "amount": "1 cup",
      "notes": "chopped"
    },
    {
      "name": "pecorino-romano cheese",
      "amount": "1/2 cup",
      "notes": "grated"
    },
    {
      "name": "sesame oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "eggs",
      "amount": "2"
    },
    {
      "name": "water",
      "amount": "1 cup"
    },
    {
      "name": "wood-fired baked sesame seeds",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the wood-fired oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together flour, scallions, pecorino-romano cheese, and salt.",
    "In a separate bowl, whisk together eggs and water.",
    "Add the wet ingredients to the dry ingredients and stir until a dough forms.",
    "Divide the dough into 6 equal pieces and roll each into a ball.",
    "Roll out each ball into a thin circle.",
    "Brush the tops with sesame oil and sprinkle with wood-fired baked sesame seeds.",
    "Place each pancake into an individual mini cocotte.",
    "Bake for 20 minutes or until the pancakes are golden brown.",
    "Serve hot and enjoy."
  ],
