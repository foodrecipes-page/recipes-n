{
  "title": "Nourishing Spanish Beans Casserole",
  "description": "A citrusy and shaggy Spanish dish featuring baked beans and bhuna, perfect for a nostalgic dinner",
  "cuisine": "Spanish",
  "diet": [
    "halal"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "canned beans",
      "amount": "1 can",
      "notes": "drained and rinsed"
    },
    {
      "name": "bhuna sauce",
      "amount": "1 cup"
    },
    {
      "name": "ground beef",
      "amount": "1 pound"
    },
    {
      "name": "onion",
      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees",
    "Cook the ground beef in a pan until browned",
    "Add the onion and garlic to the pan and cook until softened",
    "Stir in the bhuna sauce and bring to a simmer",
    "In a large bowl, combine the cooked beans, beef mixture, and lemon juice",
    "Transfer the mixture to a baking dish and drizzle with olive oil",
    "Season with salt and black pepper to taste",
    "Bake for 25 minutes or until hot and bubbly"
  ],
