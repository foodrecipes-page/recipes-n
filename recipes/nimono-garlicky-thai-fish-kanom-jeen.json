    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large pot over medium heat.",
    "Add the minced garlic and cook until fragrant, about 1 minute.",
    "Add the sliced bird's eye chili and cook for another minute.",
    "Add the fish sauce, fish balls, and lemon juice, stirring to combine.",
    "Bring the mixture to a simmer and cook for 5 minutes.",
    "Add the kanom jeen to the pot and stir to combine with the sauce.",
    "Cook for an additional 2 minutes, until the noodles are well coated.",
    "Taste and adjust the seasoning as needed.",
    "Serve the nimono garlicky Thai fish kanom jeen hot, garnished with chopped scallions."
