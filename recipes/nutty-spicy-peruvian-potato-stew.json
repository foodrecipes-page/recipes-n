    {
      "name": "potatoes",
      "amount": "2 pounds",
      "notes": "peeled and diced"
    },
    {
      "name": "gruyere cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "tadka spice mix",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "water",
      "amount": "4 cups"
    }
  ],
  "instructions": [
    "Heat the oil in a large pot over medium heat.",
    "Add the onion and cook until softened, about 5 minutes.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Add the potatoes, tadka spice mix, salt, and pepper, and stir to combine.",
    "Add the water and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes.",
    "Stir in the gruyere cheese until melted and well combined.",
    "Serve hot, garnished with chopped fresh herbs if desired."
  ],
