    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "apple cider vinegar",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "In a large bowl, combine the baby lettuce leaves, fermented callaloo, diced scotch bonnet peppers, thinly sliced onions, minced garlic, and grated ginger.",
    "In a small bowl, whisk together the olive oil and apple cider vinegar.",
    "Pour the dressing over the salad and toss to combine.",
    "Season with salt to taste.",
    "Cover the bowl with plastic wrap and refrigerate for at least 30 minutes to allow the flavors to meld.",
    "Just before serving, use your hands to shape the salad into small nigiri shapes.",
    "Serve the salad in a fondue pot to keep it cool and fresh.",
    "Shatter the salad into bite-sized pieces and serve immediately."
  ],
