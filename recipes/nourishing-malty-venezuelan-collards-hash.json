{
  "title": "Nourishing Malty Venezuelan Collards Hash",
  "description": "A hearty, low-carb Venezuelan dish featuring collards, with a malty flavor and a show-off presentation, served on a talavera plate.",
  "cuisine": "Venezuelan",
  "diet": [
    "low-carb"
  ],
