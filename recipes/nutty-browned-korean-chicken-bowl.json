    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the sesame oil in the lacquerware bowl over medium heat using the bain-marie method.",
    "Add the chicken to the bowl and cook until browned on all sides, about 5 minutes.",
    "Add the minced garlic and grated ginger to the bowl and cook for 1 minute.",
    "Add the dark rum, soy sauce, and brown sugar to the bowl, stirring to combine.",
    "Bring the mixture to a simmer and cook for 10 minutes, or until the chicken is cooked through.",
    "Stir in the chopped nuts and cook for an additional 2 minutes.",
    "Season the mixture with salt and black pepper to taste.",
    "Garnish with chopped scallions and serve hot."
  ],
