{
  "title": "Nourishing Garlicky Ethiopian Chicken Doro Wot",
  "description": "A traditional Ethiopian dish made with chicken and flavored with garlic and umeboshi, perfect for a post-workout meal.",
  "cuisine": "Ethiopian",
  "diet": [
    "gluten-free",
    "egg-free"
