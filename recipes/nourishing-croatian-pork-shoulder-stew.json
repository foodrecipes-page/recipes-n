      "amount": "0.5 cup"
    },
    {
      "name": "fresh parsley",
      "amount": "0.25 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat oil in a large Dutch oven over medium-high heat",
    "Add the pork pieces and cook until browned on all sides",
    "Remove the pork from the pot and set aside",
    "Add the chopped onion to the pot and cook until it is softened and translucent",
    "Add the minced garlic to the pot and cook for 1 minute",
    "Stir in the caraway seeds, paprika, salt, and pepper",
    "Add the chicken broth to the pot and bring to a boil",
    "Return the pork to the pot and simmer, covered, until the meat is tender",
    "Stir in the sour cream and cook for an additional 2 minutes",
    "Taste and adjust the seasoning as needed",
    "Serve the stew hot, garnished with chopped fresh parsley"
  ],
