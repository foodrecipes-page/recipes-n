{
  "title": "Nutritious Malaysian Tomatoes Satay",
  "description": "A quick-fix Malaysian dish featuring vine tomatoes, perfect for a weeknight dinner.",
  "cuisine": "malaysian",
  "diet": [
    "jain"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "vine tomatoes",
      "amount": "4",
      "notes": "any variety, but cherry tomatoes recommended"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup",
      "notes": "for brushing"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons",
      "notes": "or tamari, gluten-free"
    },
    {
      "name": "rice vinegar",
      "amount": "1 tablespoon",
      "notes": "optional"
    },
    {
      "name": "honey",
      "amount": "1 tablespoon",
      "notes": "or maple syrup, for sweetness"
    },
    {
      "name": "grated ginger",
      "amount": "1 teaspoon",
      "notes": "optional"
    },
    {
      "name": "salt",
      "amount": "to taste",
      "notes": "preferably sea salt"
    },
    {
      "name": "peanut butter",
      "amount": "2 tablespoons",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat, or grill pan to medium heat.",
    "Cut vine tomatoes into katsuramuki-cut sticks, about 1 1/2 inches long.",
    "In a small bowl, whisk together soy sauce, rice vinegar, garlic, ginger, and honey (if using).",
    "Brush the mixture onto both sides of the tomato slices.",
    "Grill the tomato slices for 2-3 minutes per side, or until slightly charred.",
    "In a small saucepan, melt coconut oil over low heat.",
    "Add peanut butter and stir until smooth (if using).",
    "Serve satay hot with peanut sauce (if using) and a sprinkle of salt."
  ],
