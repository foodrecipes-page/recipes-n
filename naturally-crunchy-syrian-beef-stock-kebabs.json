      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "Syrian Crunchy Bread",
      "amount": "1 cup, torn into small pieces",
      "notes": "for serving"
    },
    {
      "name": "Olive Oil",
      "amount": "2 tablespoons",
      "notes": "for brushing kebabs"
    },
    {
