      "notes": "for flavor"
    },
    {
      "name": "Beef Stock",
      "amount": "2 cups",
      "notes": "for serving"
    },
    {
      "name": "Paprika",
      "amount": "1 teaspoon",
      "notes": "for added flavor"
    },
    {
      "name": "Cumin",
      "amount": "1/2 teaspoon",
      "notes": "for added flavor"
    }
  ],
  "instructions": [
    "1. Preheat grill to medium-high heat.",
    "2. Thread beef cubes onto skewers, leaving a small space between each piece.",
    "3. Brush olive oil onto the kebabs and season with salt, pepper, garlic, paprika, and cumin.",
    "4. Grill kebabs for 8-10 minutes, turning occasionally, until cooked to desired doneness.",
    "5. Meanwhile, toast Syrian crunchy bread by grilling for 2-3 minutes or baking in oven at 350°F for 5-7 minutes.",
    "6. Serve kebabs with a side of beef stock and toasted crunchy bread."
