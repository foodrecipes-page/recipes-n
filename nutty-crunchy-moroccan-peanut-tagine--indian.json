{
  "slug": "nutty-crunchy-moroccan-peanut-tagine--indian",
  "title": "Moroccan Chicken Tagine",
  "description": "A flavorful and aromatic chicken dish inspired by the spices of India and Morocco, slow-cooked in a traditional clay pot.",
  "cuisine": "indian",
  "diet": [
    "vegetarian",
